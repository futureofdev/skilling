{
  "$defs": {
    "Brand": {
      "additionalProperties": false,
      "description": "Facts a tutor may not invent. Since 1.1.\n\nEvery field is optional, and a runtime composing ceremony copy may state nothing that is\nnot here \u2014 the whole point is that a model asked for a share post will otherwise guess a\nhandle, confidently and wrongly.",
      "properties": {
        "handles": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Handles",
          "type": "object"
        },
        "hashtags": {
          "items": {
            "type": "string"
          },
          "title": "Hashtags",
          "type": "array"
        },
        "mention": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mention"
        },
        "product": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "Brand",
      "type": "object"
    },
    "Ceremony": {
      "additionalProperties": false,
      "description": "Since 1.1. Facts plus optional literal templates.",
      "properties": {
        "brand": {
          "anyOf": [
            {
              "$ref": "#/$defs/Brand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "course_completed_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Course Completed Template"
        },
        "phase_completed_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase Completed Template"
        }
      },
      "title": "Ceremony",
      "type": "object"
    },
    "LessonEntry": {
      "additionalProperties": false,
      "properties": {
        "homework": {
          "default": false,
          "title": "Homework",
          "type": "boolean"
        },
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "slug": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Slug",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "number",
        "slug",
        "title"
      ],
      "title": "LessonEntry",
      "type": "object"
    },
    "PhaseEntry": {
      "additionalProperties": false,
      "properties": {
        "highlight": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Highlight"
        },
        "lessons": {
          "items": {
            "$ref": "#/$defs/LessonEntry"
          },
          "minItems": 1,
          "title": "Lessons",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "number": {
          "minimum": 0,
          "title": "Number",
          "type": "integer"
        },
        "slug": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Slug",
          "type": "string"
        }
      },
      "required": [
        "number",
        "slug",
        "name",
        "lessons"
      ],
      "title": "PhaseEntry",
      "type": "object"
    },
    "Skill": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Skill",
      "type": "object"
    },
    "Tutor": {
      "additionalProperties": false,
      "description": "Guidance for how a tutor speaks. Nothing behavioural depends on it.",
      "properties": {
        "persona": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Persona"
        },
        "tone": {
          "items": {
            "type": "string"
          },
          "title": "Tone",
          "type": "array"
        }
      },
      "title": "Tutor",
      "type": "object"
    }
  },
  "$id": "https://startskill.ing/schemas/v1.3/course.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated from the Pydantic models by `task schemas`. Informative only \u2014 spec/course-format.md and spec/runtime.md are normative.",
  "properties": {
    "authors": {
      "items": {
        "type": "string"
      },
      "title": "Authors",
      "type": "array"
    },
    "ceremony": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ceremony"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "language": {
      "default": "en",
      "title": "Language",
      "type": "string"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "phases": {
      "items": {
        "$ref": "#/$defs/PhaseEntry"
      },
      "minItems": 1,
      "title": "Phases",
      "type": "array"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/Skill"
      },
      "title": "Skills",
      "type": "array"
    },
    "spec_version": {
      "title": "Spec Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "tutor": {
      "anyOf": [
        {
          "$ref": "#/$defs/Tutor"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "spec_version",
    "id",
    "title",
    "version",
    "phases"
  ],
  "title": "A Skilling course manifest (course.yaml)",
  "type": "object"
}
