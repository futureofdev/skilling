{
  "$defs": {
    "Assignment": {
      "additionalProperties": false,
      "properties": {
        "coordinate": {
          "title": "Coordinate",
          "type": "string"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "minItems": 1,
          "title": "Requirements",
          "type": "array"
        },
        "stretch_goals": {
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "title": "Stretch Goals",
          "type": "array"
        },
        "submission": {
          "title": "Submission",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "unlocked_at": {
          "format": "date-time",
          "title": "Unlocked At",
          "type": "string"
        }
      },
      "required": [
        "coordinate",
        "title",
        "objective",
        "requirements",
        "submission",
        "unlocked_at"
      ],
      "title": "Assignment",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "verdict": {
          "anyOf": [
            {
              "enum": [
                "met",
                "partial",
                "not-yet"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict"
        }
      },
      "required": [
        "text"
      ],
      "title": "Requirement",
      "type": "object"
    }
  },
  "$id": "https://startskill.ing/schemas/v1.3/homework-slot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated from the Pydantic models by `task schemas`. Informative only \u2014 spec/course-format.md and spec/runtime.md are normative.\n\nThe mailbox. An absent ``active.yaml`` means the slot is empty, so there is no\n'empty' variant of this model \u2014 absence is represented by absence.",
  "properties": {
    "coordinate": {
      "title": "Coordinate",
      "type": "string"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "queued": {
      "items": {
        "$ref": "#/$defs/Assignment"
      },
      "title": "Queued",
      "type": "array"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "stretch_goals": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Stretch Goals",
      "type": "array"
    },
    "submission": {
      "title": "Submission",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "unlocked_at": {
      "format": "date-time",
      "title": "Unlocked At",
      "type": "string"
    }
  },
  "required": [
    "coordinate",
    "title",
    "objective",
    "requirements",
    "submission",
    "unlocked_at"
  ],
  "title": "The homework mailbox slot (active.yaml)",
  "type": "object"
}
