{
  "$defs": {
    "Objective": {
      "additionalProperties": false,
      "description": "An addressable learning objective. Since 1.1; ``kind`` and ``verify`` since 1.2.\n\nA lesson's contract, given an id so a tutor can target remediation at the one a wrong\nanswer implicates instead of re-presenting the whole concept.",
      "properties": {
        "about": {
          "items": {
            "type": "integer"
          },
          "title": "About",
          "type": "array"
        },
        "check": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "knowledge",
            "practice"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "verify": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verify"
        }
      },
      "required": [
        "id",
        "kind",
        "text"
      ],
      "title": "Objective",
      "type": "object"
    },
    "SectionAbsence": {
      "additionalProperties": false,
      "description": "A declared absence. ``intent`` is lenient here so the validator can report a\nmissing reason with its own code rather than a generic parse failure.",
      "properties": {
        "intent": {
          "default": "",
          "title": "Intent",
          "type": "string"
        },
        "status": {
          "const": "none",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "SectionAbsence",
      "type": "object"
    }
  },
  "$id": "https://startskill.ing/schemas/v1.4/lesson-frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated from the Pydantic models by `task schemas`. Informative only \u2014 the specification in spec/ is normative.",
  "properties": {
    "duration_minutes": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Minutes"
    },
    "lesson": {
      "minimum": 1,
      "title": "Lesson",
      "type": "integer"
    },
    "objectives": {
      "items": {
        "$ref": "#/$defs/Objective"
      },
      "title": "Objectives",
      "type": "array"
    },
    "phase": {
      "minimum": 0,
      "title": "Phase",
      "type": "integer"
    },
    "prerequisites": {
      "items": {
        "type": "string"
      },
      "title": "Prerequisites",
      "type": "array"
    },
    "sections": {
      "additionalProperties": {
        "anyOf": [
          {
            "const": "present",
            "type": "string"
          },
          {
            "$ref": "#/$defs/SectionAbsence"
          }
        ]
      },
      "title": "Sections",
      "type": "object"
    },
    "skills_unlocked": {
      "items": {
        "type": "string"
      },
      "title": "Skills Unlocked",
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "title",
    "phase",
    "lesson"
  ],
  "title": "The YAML frontmatter of a lesson",
  "type": "object"
}
